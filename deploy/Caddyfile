# Cloudflare (proxied, SSL mode "Full (strict)") -> this Caddy -> the APIs.
# TLS uses a Cloudflare Origin Certificate for <domain> and *.<domain>, saved in ./certs.
{
	# Browsers never talk to this server directly, only Cloudflare does, so no automatic certificates.
	auto_https off
	servers {
		# Trust Cloudflare's addresses and take the real visitor IP from CF-Connecting-IP.
		# Current list: https://www.cloudflare.com/ips/
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(origin_tls) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
}

# Angular app + API for one deployment. {args[0]} = the API container.
(qrenvo_app) {
	import origin_tls
	import security_headers
	encode zstd gzip
	request_body {
		max_size 20MB
	}

	handle /api/* {
		reverse_proxy {args[0]}:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle /uploads/* {
		reverse_proxy {args[0]}:8080
		header Cache-Control "public, max-age=2592000"
	}
	# Swagger is off outside Development; never expose it here either.
	handle /swagger* {
		respond 404
	}
	handle {
		root * /srv/web
		# Angular names built files "main-6VLZRHSG.js", "chunk-2HIOWQN3.js": the hash changes whenever the
		# content does, so Cloudflare and browsers may keep them for a year. Everything else (index.html,
		# icons) is checked on every visit so a deploy shows up straight away.
		@hashed path_regexp [-.][0-9A-Za-z]{8,}\.(js|css|woff2?)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell not path_regexp [-.][0-9A-Za-z]{8,}\.(js|css|woff2?)$
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Marketing / sales page.
{$ROOT_DOMAIN}, www.{$ROOT_DOMAIN} {
	import origin_tls
	import security_headers
	encode zstd gzip
	@www host www.{$ROOT_DOMAIN}
	redir @www https://{$ROOT_DOMAIN}{uri} permanent
	root * /srv/landing
	try_files {path} /index.html
	file_server
}

# Demo: its own API and database (QrMenuDemo).
demo.{$ROOT_DOMAIN} {
	import qrenvo_app api-demo
}

# Prod: the owner panel at app.<domain> and every restaurant at <name>.<domain>.
# Caddy picks the exact demo.<domain> block above over this wildcard.
app.{$ROOT_DOMAIN}, *.{$ROOT_DOMAIN} {
	import qrenvo_app api-prod
}
