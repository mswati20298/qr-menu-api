# Cloudflare (proxied, SSL mode "Full (strict)") -> this Caddy -> the APIs.
# TLS uses a Cloudflare Origin Certificate for <domain> and *.<domain>, saved in ./certs.
{
	# Browsers never talk to this server directly, only Cloudflare does, so no automatic certificates.
	auto_https off
	servers {
		# Trust Cloudflare's addresses and take the real visitor IP from CF-Connecting-IP.
		# Current list: https://www.cloudflare.com/ips/
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(origin_tls) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		# Camera: menu photo scan, and Razorpay's window (card scan). Motion sensors: Razorpay's fraud checks only.
		# Payment: Razorpay checkout. Microphone, location and USB: off.
		Permissions-Policy "camera=(self \"https://api.razorpay.com\" \"https://checkout.razorpay.com\"), accelerometer=(self \"https://api.razorpay.com\" \"https://checkout.razorpay.com\"), gyroscope=(self \"https://api.razorpay.com\" \"https://checkout.razorpay.com\"), microphone=(), geolocation=(), payment=(self \"https://checkout.razorpay.com\" \"https://api.razorpay.com\"), usb=()"
		-Server
	}
}

# Only our own scripts run (no inline scripts), so an injected <script> or onerror= cannot steal a login token.
# Razorpay: checkout script, its payment frame and its API. Cloudflare Web Analytics: its beacon script and endpoint. Styles allow inline: Angular adds component styles that way.
(app_csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self' https://*.razorpay.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.razorpay.com https://cloudflareinsights.com; frame-src https://*.razorpay.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://*.razorpay.com; frame-ancestors 'self'"
}

# Same policy, but the browser only reports breaks (console) and blocks nothing. Use it to try a policy change
# on a site first (swap "import app_csp" for this), then switch back.
(app_csp_report_only) {
	header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://*.razorpay.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.razorpay.com https://cloudflareinsights.com; frame-src https://*.razorpay.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://*.razorpay.com; frame-ancestors 'self'"
}

(landing_csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://app.qrenvo.com https://demo.qrenvo.com https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
}

# Angular app + API for one deployment. {args[0]} = the API container.
(qrenvo_app) {
	import origin_tls
	import security_headers
	encode zstd gzip
	request_body {
		max_size 20MB
	}

	handle /api/* {
		reverse_proxy {args[0]}:8080 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle /uploads/* {
		# Cache-Control comes from the API, only on real photos (a header here also went on 404s).
		reverse_proxy {args[0]}:8080
	}
	# Swagger is off outside Development; never expose it here either.
	handle /swagger* {
		respond 404
	}
	handle {
		root * /srv/web
		# Angular names built files "main-6VLZRHSG.js", "chunk-2HIOWQN3.js": the hash changes whenever the
		# content does, so Cloudflare and browsers may keep them for a year. Everything else (index.html,
		# icons) is checked on every visit so a deploy shows up straight away.
		@hashed path_regexp [-.][0-9A-Za-z]{8,}\.(js|css|woff2?)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell not path_regexp [-.][0-9A-Za-z]{8,}\.(js|css|woff2?)$
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Marketing / sales page.
{$ROOT_DOMAIN}, www.{$ROOT_DOMAIN} {
	import origin_tls
	import security_headers
	import landing_csp
	encode zstd gzip
	@www host www.{$ROOT_DOMAIN}
	redir @www https://{$ROOT_DOMAIN}{uri} permanent
	root * /srv/landing
	try_files {path} /index.html
	file_server
}

# Demo: its own API and database (QrMenuDemo).
demo.{$ROOT_DOMAIN} {
	import qrenvo_app api-demo
	import app_csp
}

# Prod: the owner panel at app.<domain> and every restaurant at <name>.<domain>.
# Caddy picks the exact demo.<domain> block above over this wildcard.
app.{$ROOT_DOMAIN}, *.{$ROOT_DOMAIN} {
	import qrenvo_app api-prod
	import app_csp
}
